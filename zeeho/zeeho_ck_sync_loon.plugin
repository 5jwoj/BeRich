[Script]
http-request ^https?:\/\/h5\.zeehoev\.com\/cfmotoservermine\/signin script-path=https://raw.githubusercontent.com/5jwoj/BeRich/main/zeeho/zeeho_ck_sync_loon.js, requires-body=false, timeout=30, tag=极核ZEEHO CK同步

[Mitm]
hostname = h5.zeehoev.com
