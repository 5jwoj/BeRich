#!name = 博卡经理端 · 去除启动倒计时
#!desc = 根据抓包结果：开屏广告来自 api.bokao2o.com/message/advert/list，返回空列表即可跳过开屏倒计时。需开启 HTTPS 解密。
#!author = WorkBuddy
#!version = 1.1
#!loon_version = 3.5.1(978)
#!date = 2026-11-08
#!tag = 去广告,小程序,博卡
#!type = normal

# v1.1 抓包确认：开屏广告接口为 https://api.bokao2o.com/message/advert/list/p/g8Manager/get?isAll=1
#      (飞行模式下该请求失败则无倒计时)。原版 Mitm 未包含 api.bokao2o.com 导致不生效。
# v1.0 初版，按关键词猜测域名与字段。
#
# 若仍有倒计时，把下面的 response 规则换成：
# request if ${url} ~= /^https:\/\/api\.bokao2o\.com\/message\/advert\/list\// then reject

[Rewrite]
# 开屏广告列表 -> 返回空数组（不用 {}，避免前端解析报错）
response if ${url} ~= /^https:\/\/api\.bokao2o\.com\/message\/advert\/list\// && ${response.status} == 200 then response.body.replace(/"result":\[.*\],"success"/s, "\"result\":[],\"success\"")

[Mitm]
hostname = api.bokao2o.com
