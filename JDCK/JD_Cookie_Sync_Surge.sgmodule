#!name=JD Cookie Sync (v1.4.0 BoxJS配置)
#!desc=每次打开京东 APP 自动同步 Cookie 至青龙面板。配置通过 BoxJS 订阅「BeRich 订阅合集」填写，无需在模块内配置参数。
#!author=z.W.
#!icon=https://raw.githubusercontent.com/Orz-3/mini/master/jd.png

[Script]
# 覆盖常见京东域名，提高命中率。命中时从 request header 的 Cookie 里提取 pt_key/pt_pin。
JD Cookie Sync = type=http-request,pattern=^https?:\/\/(api\.m|me-api|plogin\.m|wq|home\.m)\.jd\.com,requires-body=0,max-size=0,script-path=https://raw.githubusercontent.com/5jwoj/BeRich/main/JDCK/JD_Cookie_Sync_Surge.js,script-update-interval=0,timeout=20

[MITM]
# 需要 MITM 才能读取 HTTPS 请求头 Cookie
hostname = %APPEND% api.m.jd.com, me-api.jd.com, plogin.m.jd.com, wq.jd.com, home.m.jd.com
