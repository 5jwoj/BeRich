[Script]
# 定时任务：每天 23:35 执行，从青龙面板读取资产日志并推送京豆汇总通知
cron "35 23 * * *" script-path=https://raw.githubusercontent.com/5jwoj/BeRich/main/JDCK/JD_Bean_Query_Loon.js, timeout=60, tag=京豆资产查询
