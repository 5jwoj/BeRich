#!icon=https://raw.githubusercontent.com/58xinian/icon/master/jd_sy.png
#!date=2026-08-21 00:00:00

[Script]
http-request ^https?:\/\/api\.m\.jd\.com\/ script-path=https://raw.githubusercontent.com/5jwoj/BeRich/main/JDCK/JD_Cookie_Sync_Loon.js, requires-body=false, tag=京东Cookie同步

[Mitm]
hostname = api.m.jd.com
