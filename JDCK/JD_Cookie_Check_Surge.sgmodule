#!name=JD 账号过期检测 (v1.0.0 BoxJS配置)
#!desc=定时扫描青龙面板日志，检测京东账号 Cookie 是否过期失效并推送预警通知，参数通过 BoxJS 订阅「BeRich Surge 合集」配置。
#!author=z.W.
#!icon=https://raw.githubusercontent.com/58xinian/icon/master/jd_sy.png

[Script]
# 定时任务：每天 6:35 ~ 23:35 每小时执行一次，检测账号 Cookie 是否过期
JD账号过期检测 = type=cron,cronexp=35 6-23 * * *,script-path=https://raw.githubusercontent.com/5jwoj/BeRich/main/JDCK/JD_Cookie_Check_Surge.js,script-update-interval=86400,timeout=60
