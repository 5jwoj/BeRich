#!name = V2EX 每日签到 (v1.0.10 修复版)
#!desc = V2EX 每日签到 + Cookie 自动捕获。修复签到请求超时、代理策略无效、Cookie 被匿名会话覆盖、网络错误误报为 Cookie 失效等问题。
#!openUrl = http://boxjs.com/#/app/v2ex.daily.loon
#!author = 5jwoj[https://github.com/5jwoj]
#!homepage = https://github.com/5jwoj/BeRich/tree/main/V2EX
#!icon = https://www.v2ex.com/favicon.ico
#!tag = 签到, V2EX
#!version = 1.0.10
#!date = 2026-11-09 12:50:00

# ==============================================================================
# V2EX 每日签到 Loon 插件 v1.0.10
#
# 【本版修复】
#  1. 脚本内 $httpClient 的 timeout 单位是毫秒，旧版传 30 等于 30ms，
#     签到请求必然超时 → 改为 10000ms。
#  2. Loon 指定出口用 node 参数，旧版写 policy 被忽略 → 改为 node。
#  3. 显式关闭 auto-redirect / auto-cookie，避免 Loon 改写手工传入的登录 Cookie。
#  4. 脚本自身请求带 X-V2EX-Script 标记，捕获逻辑自动跳过，杜绝「自己抓自己」。
#  5. http-response 捕获规则收窄到 /signin，且只有响应下发 A2/A 才写入。
#     V2EX 每个响应都会下发 PB3_SESSION / V2EX_LANG，旧版全站捕获会污染 Cookie。
#  6. 网络错误与 Cookie 失效分开提示，通知里显示真实错误，不再一律
#     「请检查 Cookie 是否有效」。
#  7. 多账号按 A2 定位行更新，不再被响应合并打乱换行分隔。
#  8. 关闭 www 域名回退（www 在 MitM 内，会触发 127.0.0.1 自劫持）。
#
# 【落地方式，务必先选一种，否则 Loon 仍会拉到旧脚本】
#  方式 A（推荐，改自己的仓库）：
#    把本文件与 v2ex_daily_loon.js 覆盖到你自己的仓库同一目录。
#    下方 script-path 保持原 URL 不变，末尾的 ?v=1.0.10 用于强制 Loon 刷新脚本缓存。
#  方式 B（上传到 Gist / 自己的 CDN）：
#    把下方 3 处 script-path 的 URL 换成你自己的 js 原始文件地址。
#  方式 C（不用远程托管，本地脚本）：
#    把 v2ex_daily_loon.js 放进 iCloud Drive/Loon/Script/ 目录（Loon 需开启自动同步），
#    再把下方 3 处 script-path 整体替换为：script-path=v2ex_daily_loon.js
#    复制面板里已备好「本地脚本版 plugin」，可直接复制使用。
#
# 【使用前检查】
#  1. Loon → 设置 → HTTPS 解密(MitM) 已开启，CA 证书已安装并信任。
#  2. 用手机浏览器打开 https://www.v2ex.com/ 登录，收到「Cookie 已自动保存」。
#  3. BoxJS 中 v2ex_daily.ua 建议留空（留空时自动使用捕获到的浏览器 UA，
#     填错会导致 cf_clearance 与 UA 不匹配被 Cloudflare 拦）。
#  4. BoxJS 中 v2ex_daily.policy 可填节点名 / 策略组名 / DIRECT，对应 Loon 的 node。
#     务必与抓包时使用的出口一致，否则 Cloudflare 可能因 IP 变化拦截签到请求。
#
# 【BoxJS 订阅】
#  https://raw.githubusercontent.com/5jwoj/BeRich/main/boxjs/BeRich_Loon.boxjs.json
# ==============================================================================

[Script]
# --- ① 请求头捕获：浏览器已登录访问 V2EX 时，保存完整 Cookie + 浏览器 UA ---
http-request ^https?://(www\.)?v2ex\.com/ tag=V2EX Cookie捕获(请求头), script-path=https://raw.githubusercontent.com/5jwoj/BeRich/main/V2EX/v2ex_daily_loon.js?v=1.0.10, requires-body=false, img-url=https://www.v2ex.com/favicon.ico

# --- ② 响应头捕获：仅在 /signin 登录响应里取 A2，避免全站响应污染 Cookie ---
http-response ^https?://(www\.)?v2ex\.com/signin tag=V2EX Cookie捕获(登录响应), script-path=https://raw.githubusercontent.com/5jwoj/BeRich/main/V2EX/v2ex_daily_loon.js?v=1.0.10, requires-body=false, img-url=https://www.v2ex.com/favicon.ico

# --- ③ 每日 08:00 签到 ---
cron "0 8 * * *" script-path=https://raw.githubusercontent.com/5jwoj/BeRich/main/V2EX/v2ex_daily_loon.js?v=1.0.10, tag=V2EX每日签到, timeout=120, img-url=https://www.v2ex.com/favicon.ico, enable=true

[Mitm]
# 只解密 www 域用于捕获 Cookie；脚本出站走不带 www 的 v2ex.com，避免自劫持
hostname = www.v2ex.com
