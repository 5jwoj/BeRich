#!name = V2EX 每日签到
#!desc = V2EX 每日签到 + Cookie 自动捕获。手机浏览器登录 V2EX 时自动从响应头抓取 Cookie，无需手动操作，每天定时执行签到并推送余额通知。
#!openUrl = http://boxjs.com/#/app/v2ex.daily.loon
#!author = 5jwoj[https://github.com/5jwoj]
#!homepage = https://github.com/5jwoj/BeRich/tree/main/V2EX
#!icon = https://www.v2ex.com/favicon.ico
#!tag = 签到, V2EX
#!version = 1.0.7
#!date = 2026-10-04 18:43:00

# ==============================================================================
# V2EX 每日签到 Loon 插件 (v1.0.7 修复版)
#
# 修复说明 (v1.0.7):
#   脚本出站请求改为 v2ex.com（去掉 www 前缀）
#   原因：www.v2ex.com 在 MitM 列表中，Loon 会将脚本的 $httpClient 请求
#   也劫持到 127.0.0.1（自身的 MitM 处理器），导致请求失败、下载 0 字节
#   改用 v2ex.com（不在 MitM 列表）发出请求，则正常走代理节点
#
# 功能:
#   1. [http-response] 手机浏览器登录 V2EX 时，自动捕获服务器返回的 Session Cookie
#   2. [http-request]  已登录状态下访问 V2EX，额外从请求头捕获 Cookie（双重保障）
#   3. 每天 08:00 定时执行签到，领取每日登录奖励
#   4. 签到后推送账户余额通知（铜币、银币、金币）
#   5. 支持多账号、Cookie 过期自动更新
#
# 使用方法:
#   1. 在 Loon 中安装本插件
#   2. 确认 Loon → 设置 → HTTPS 解密 (MitM) 已开启，并已安装并信任 CA 证书
#   3. 用手机浏览器 (Chrome/Safari) 打开 https://www.v2ex.com/ 并登录
#   4. 收到「Cookie 已自动保存」通知后，脚本每天 08:00 自动签到
#
# BoxJS 可配置项 (App ID: v2ex.daily.loon):
#   - v2ex_daily.cookie: V2EX Cookie（访问网站后自动获取，无需手动填写）
#   - v2ex_daily.ua: 自定义 User-Agent（可选）
#   - v2ex_daily.policy: Loon 代理策略名（可选，如 PROXY / 香港节点 / Global 等，用于解决签到时 HTTP 超时）
#
# BoxJS 订阅 (Loon 专用):
#   https://raw.githubusercontent.com/5jwoj/BeRich/main/boxjs/BeRich_Loon.boxjs.json
# ==============================================================================

[Script]
# --- Cookie 捕获：从「响应头 Set-Cookie」获取（登录时触发，这是核心！）---
# 手机浏览器登录 V2EX 时，服务器通过 Set-Cookie 响应头下发 Session Cookie
http-response ^https?://(www\.)?v2ex\.com/ tag=V2EX Cookie捕获(响应头), script-path=https://raw.githubusercontent.com/5jwoj/BeRich/main/V2EX/v2ex_daily_loon.js, requires-body=false, img-url=https://www.v2ex.com/favicon.ico

# --- Cookie 捕获：从「请求头 Cookie」获取（已登录访问时触发，双重保障）---
http-request ^https?://(www\.)?v2ex\.com/ tag=V2EX Cookie捕获(请求头), script-path=https://raw.githubusercontent.com/5jwoj/BeRich/main/V2EX/v2ex_daily_loon.js, requires-body=false, img-url=https://www.v2ex.com/favicon.ico

# --- 每日签到 ---
# 每天 08:00 自动签到并推送余额通知
cron "0 8 * * *" script-path=https://raw.githubusercontent.com/5jwoj/BeRich/main/V2EX/v2ex_daily_loon.js, tag=V2EX每日签到, timeout=30, img-url=https://www.v2ex.com/favicon.ico, enable=true

[Mitm]
# 只保留 www.v2ex.com 做 MitM（用于捕获浏览器登录时的 Cookie）
# 不加 v2ex.com，避免脚本的 $httpClient 请求被劫持到 127.0.0.1 导致签到失败
hostname = www.v2ex.com
