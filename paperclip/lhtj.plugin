#!name = 龙湖天街 App 签到抽奖
#!desc = 龙湖天街 App 龙珠 H5「日日签」每日签到（成长值/珑珠）+ 幸运抽奖（随机珑珠）。内置随机签到时间防风控，Cookie 一次抓取同时覆盖签到与抽奖。参数配置完全复用原作者 BoxJS 订阅。
#!openUrl = http://boxjs.com
#!author = MaYIHEI[https://github.com/MaYIHEI]
#!homepage = https://github.com/MaYIHEI/paperclip/tree/main/app/lhtj
#!icon = https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/lhtj.png
#!tag = 签到, 龙湖天街
#!version = 1.0.0
#!date = 2026-08-21

# ==============================================================================
# 声明与致谢:
# 本插件底层脚本均来源于原作者 @MaYIHEI (https://github.com/MaYIHEI/paperclip)
# 封装转为 Loon 插件形式仅为方便 Loon 用户一键导入配置与管理使用。
#
# 参数说明:
# 脚本参数与开关完全兼容并复用原作者 BoxJS 订阅中的 [龙湖天街App] (App ID: paperclip.lhtj_app)
# 原作者 BoxJS 订阅: https://raw.githubusercontent.com/MaYIHEI/paperclip/main/paperclip.boxjs.json
#
# ⚠️ 注意: 本插件为 App 通道 (L0)，与小程序通道互不兼容，勿同时启用。
#
# 插件版本: v1.0.0
# ==============================================================================

[Script]
# 1. 抓取 Cookie - 打开龙湖天街 App →「会员 / 日日签」→ 点签到按钮一次，自动抓取 L0 通道鉴权头
http-request ^https:\/\/gw2c-hw-open\.longfor\.com\/lmarketing-task-api-mvc-prod\/openapi\/task\/v1\/signature\/clock$ tag=龙湖App Cookie, script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/lhtj/lhtj.js, requires-body=false, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/lhtj.png

# 2. 随机签到 + 抽奖（密集 cron，脚本内部随机摇 8-10 点内的目标分钟，到点执行，当天不再重复）
cron "0-59/19 8-10 * * *" script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/lhtj/lhtj.js, tag=龙湖App签到, timeout=60, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/lhtj.png, enable=true

[MITM]
hostname = gw2c-hw-open.longfor.com
