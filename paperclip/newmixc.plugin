#!name = 一点万象签到
#!desc = 华润万象生活「一点万象」APP 每日签到，覆盖万象汇/万象城/万象天地等华润商场。打开 APP 停留 1 秒自动抓 Cookie，cron 每天 8:37 自动签到。参数配置完全复用原作者 BoxJS 订阅。
#!openUrl = http://boxjs.com
#!author = MaYIHEI[https://github.com/MaYIHEI]
#!homepage = https://github.com/MaYIHEI/paperclip/tree/main/app/newmixc
#!icon = https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/newmixc.png
#!tag = 签到, 华润万象
#!version = 1.0.0
#!date = 2026-08-21

# ==============================================================================
# 声明与致谢:
# 本插件底层脚本均来源于原作者 @MaYIHEI (https://github.com/MaYIHEI/paperclip)
# 封装转为 Loon 插件形式仅为方便 Loon 用户一键导入配置与管理使用。
#
# 参数说明:
# 脚本参数与开关完全兼容并复用原作者 BoxJS 订阅中的 [一点万象] (App ID: paperclip.newmixc)
# 原作者 BoxJS 订阅: https://raw.githubusercontent.com/MaYIHEI/paperclip/main/paperclip.boxjs.json
#
# 插件版本: v1.0.0
# ==============================================================================

[Script]
# 1. 抓取 Cookie - 打开「一点万象」APP，进入任意页面停留 1 秒（自动触发 getPersonalData 接口），收到通知即抓取成功
http-request ^https:\/\/app\.mixcapp\.com\/mixc\/api\/v4\/member\/getPersonalData tag=一点万象 Cookie, script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/newmixc/newmixc.cookie.js, requires-body=false, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/newmixc.png

# 2. 每日签到 - 每天 08:37 自动执行
cron "37 8 * * *" script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/newmixc/newmixc.js, tag=一点万象签到, timeout=60, img-url=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/newmixc.png, enable=true

[MITM]
hostname = app.mixcapp.com
