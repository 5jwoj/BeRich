#!name = WPS 签到与福利
#!desc = WPS Office 每日签到 + 福利中心多项任务（打卡领会员、天天抽奖、会员试用申请、限量爆款领取、小程序打卡），送 WPS 积分与会员时长。参数配置完全复用原作者 BoxJS 订阅。
#!openUrl = http://boxjs.com
#!author = MaYIHEI[https://github.com/MaYIHEI]
#!homepage = https://github.com/MaYIHEI/paperclip/tree/main/app/wps
#!icon = https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/wps.png
#!tag = 签到, WPS
