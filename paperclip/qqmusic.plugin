#!name = QQ 音乐签到与福利
#!desc = QQ 音乐绿钻成长值、金币中心签到、每日任务、定时金币与红包雨自动领奖。参数配置完全复用原作者 BoxJS 订阅。
#!openUrl = http://boxjs.com
#!author = MaYIHEI[https://github.com/MaYIHEI]
#!homepage = https://github.com/MaYIHEI/paperclip/tree/main/app/qqmusic
#!icon = https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/qqmusic.png
