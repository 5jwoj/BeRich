#!name = YouTube Enhance (Loon 兼容版)
#!desc = 信息流/推荐列表去广告 + 自动最高画质。完整版（贴片广告、去 Shorts/AI/商店等）依赖 Surge 专用 webview 引擎脚本，Loon 运行时暂不支持，详见文内 v1.2.0 说明。基于 @gholts 的 Surge 模块与 @app2smile 的 Loon 去广告脚本，底层代码源自 @Maasea 的 YouTube.Enhance (Apache-2.0)。
#!author = gholts[https://github.com/gholts/surge] · app2smile[https://github.com/app2smile/rules] · Maasea[https://github.com/Maasea/sgmodule]
#!homepage = https://github.com/5jwoj/BeRich/tree/main/YouTube
#!icon = https://www.youtube.com/favicon.ico
#!system = iOS,iPadOS
#!tag = YouTube, 去广告, Loon
#!type = normal
#!version = 1.2.0
#!date = 2026-11-20

# ==============================================================================
# 声明与致谢 / Credits & Thanks
#
# · 原 Surge 模块作者：@gholts   https://github.com/gholts/surge
#   modules/youtube-enhance.sgmodule —— 沿用其 request 脚本、匹配规则与参数设计。
# · 信息流去广告脚本作者：@app2smile   https://github.com/app2smile/rules
#   js/youtube.js —— Loon 社区久经验证的去广告脚本（browse/next 信息流广告），
#   本插件直接从其仓库实时加载，未做任何改动。
# · 底层代码作者：@Maasea   https://github.com/Maasea/sgmodule
#   原模块注明 "Based on Maasea's code (Apache-2.0)"，遵循 Apache-2.0 许可。
#
# 衷心感谢 @gholts、@app2smile 与 @Maasea 的开源分享！各脚本版权与许可均归
# 各原作者所有，脚本均从原作者仓库实时加载。
#
# ------------------------------------------------------------------------------
# 版本历史 / Loon 兼容性说明：
#
# v1.2.0：
#   v1.1.0 在 Loon 上能正常打开 YouTube，但去广告失效——原模块的去广告主力
#   全在 response.js 的 protobuf 响应改写里（Loon 上无法运行）。本版接入
#   @app2smile 的 Loon 原生去广告脚本（匹配 browse/next 响应，timeout=10
#   防挂起），屏蔽首页瀑布流与播放页推荐列表广告。
#   已知局限：视频贴片广告（片头广告）无法屏蔽——需要 player 响应的
#   protobuf 深度改写，该实现依赖 Surge webview 引擎，Loon 暂无对应方案。
#
# v1.1.0：
#   v1.0.0 会导致 YouTube 无法打开。原因是 response.js / ump.js / key.js 为
#   Surge 专用（engine=webview 浏览器运行时），在 Loon 的 JSC 运行时下崩溃
#   且不调用 $done()，browse / player / initplayback 等核心请求被挂死。
#   本版移除这三条脚本，保留 request.js（自带 try/catch 兜底，安全）。
# ==============================================================================

[Argument]
auto_hd = switch,true,type=boolean,tag=自动最高画质,desc=Prefer highest offered resolution and Premium bitrate

[Script]
# 信息流/推荐列表广告（app2smile，Loon 原生验证）
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next) script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/youtube.js,requires-body=true,binary-body-mode=true,timeout=10,tag=YT.feed-ads
# 以下四条来自 gholts/surge 的 request.js（Loon 安全，自带兜底）
http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js,tag=YT.ad-break
http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js,requires-body=true,binary-body-mode=true,tag=YT.init,argument="{"autoHd":{auto_hd}}"
http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js,requires-body=true,binary-body-mode=true,enable={auto_hd},tag=YT.auto-hd,argument="{"autoHd":{auto_hd}}"
http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js,tag=YT.log-event

[Rewrite]
^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ reject
^https:\/\/s\.youtube\.com\/api\/stats\/ads reject

[MITM]
hostname = *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com
